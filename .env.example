# Verilənlər bazası
DB_HOST=localhost
DB_PORT=5433
DB_NAME=order_tracker
DB_USERNAME=
DB_PASSWORD=

# JWT - generasiya üçün: openssl rand -base64 32
JWT_SECRET=

# İlk admin hesabı (DataInitializer tərəfindən avtomatik yaradılır)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@ordertracker.local
ADMIN_PASSWORD=

# Mail (dev üçün MailHog/Mailpit: localhost:1025)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=no-reply@ordertracker.local

# Webhook imza yoxlaması üçün gizli açar
WEBHOOK_SECRET=
